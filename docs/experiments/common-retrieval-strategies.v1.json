{
  "schemaVersion": 1,
  "id": "common-retrieval-strategies-v1",
  "title": "Dense, lexical, and rank-fusion retrieval comparison",
  "hypothesis": "BM25 will improve exact technical-term matching, while hybrid RRF will preserve semantic recall and reduce the weaknesses of either retriever alone.",
  "baseExperimentConfig": "common-programming-word-300-validation.json",
  "split": "validation",
  "topK": 4,
  "candidateDepth": 100,
  "strategies": [
    {
      "id": "dense-cosine",
      "thresholds": [0.18, 0.4, 0.5, 0.55, 0.6, 0.65, 0.7, 0.75, 0.8]
    },
    {
      "id": "bm25",
      "parameters": { "k1": 1.2, "b": 0.75 },
      "thresholds": [0, 1, 2, 4, 6, 8, 10, 12, 16, 20]
    },
    {
      "id": "hybrid-rrf",
      "parameters": { "rankConstant": 60 },
      "thresholds": [0, 0.015, 0.02, 0.022, 0.024, 0.026, 0.028, 0.03, 0.032]
    }
  ],
  "selectionRule": {
    "primary": "noAnswerFalsePositiveRate",
    "primaryTarget": 0,
    "guardrails": { "recallAtK": 1, "mrr": 1 },
    "tieBreakers": ["ndcgAtK:higher", "precisionAtK:higher", "threshold:lower"]
  },
  "controlledVariables": [
    "corpus snapshot",
    "golden-set validation cases",
    "300-word chunks with 80-word overlap",
    "topK=4",
    "Gemini embedding model and dimensionality for strategies that use vectors"
  ],
  "reportOutput": "docs/experiment-results/common-retrieval-strategies-validation"
}
