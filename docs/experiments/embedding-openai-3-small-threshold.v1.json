{
  "schemaVersion": 1,
  "id": "embedding-openai-3-small-threshold-v1",
  "title": "OpenAI text-embedding-3-small validation threshold calibration",
  "hypothesis": "A model-specific cosine threshold can remove validation false positives without reducing OpenAI Small's low-threshold retrieval quality.",
  "baseExperimentConfig": "embedding-openai-3-small-1024.json",
  "variedPath": "retrieval.minScore",
  "thresholds": [0.18, 0.3, 0.4, 0.45, 0.5, 0.55, 0.6, 0.65, 0.7, 0.75, 0.8, 0.85, 0.9],
  "selectionRule": {
    "primary": "noAnswerFalsePositiveRate",
    "primaryDirection": "lower",
    "guardrails": [{ "metric": "recallAtK", "minimum": 0.8333333333333334 }, { "metric": "mrr", "minimum": 0.6388888888888888 }],
    "tieBreakers": [{ "metric": "ndcgAtK", "direction": "higher" }, { "metric": "threshold", "direction": "lower" }, { "metric": "precisionAtK", "direction": "higher" }]
  },
  "readiness": { "status": "exploratory", "reason": "Model selection uses the validation split only; the previously observed test split is excluded." },
  "reportOutput": "docs/experiment-results/embedding-openai-3-small-threshold-validation"
}
