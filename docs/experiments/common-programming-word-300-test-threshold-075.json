{
  "schemaVersion": 1,
  "id": "common-programming-word-300-test-threshold-075",
  "title": "Common programming corpus - locked test at threshold 0.75",
  "hypothesis": "The validation-selected 0.75 threshold will preserve Recall@4 while reducing no-answer false positives on the untouched balanced test split.",
  "tags": ["held-out-test", "threshold-0.75", "common-corpus"],
  "corpus": {
    "manifests": ["docs/corpus/react-learn.json", "docs/corpus/programming-foundation.json"]
