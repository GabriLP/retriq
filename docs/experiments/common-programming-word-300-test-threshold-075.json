  "embedding": {
    "provider": "google",
    "model": "gemini-embedding-2",
    "outputDimensionality": 768,
    "documentTask": "RETRIEVAL_DOCUMENT",
    "queryTask": "QUESTION_ANSWERING",
    "batchSize": 32,
    "pricing": {
      "requestMode": "standard",
      "usdPerMillionInputTokens": 0.2,
      "observedAt": "2026-07-16",
      "sourceUrl": "https://ai.google.dev/gemini-api/docs/pricing"
    }
  },
  "retrieval": { "strategy": "dense-cosine", "topK": 4, "minScore": 0.75 },
  "generation": { "provider": "google", "model": "gemini-3.5-flash" },
  "evaluation": {
    "judgeEnabled": false,
    "judgeModel": "gemini-3.5-flash",
    "goldenSet": "docs/evaluation/golden-set.v1.json",
