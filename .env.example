GEMINI_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Runtime answer budget. Gemini reasoning tokens count toward this limit.
RETRIQ_GENERATION_MAX_OUTPUT_TOKENS=2048
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# The checked-in legacy JSON store uses 768 dimensions. The selected PostgreSQL
# production corpus uses 1024; change both this value and the backend together.
GEMINI_EMBEDDING_OUTPUT_DIMENSIONALITY=768
# Use postgres only after migrations, import, activation, and parity checks pass.
RETRIQ_VECTOR_STORE_BACKEND=json
DATABASE_URL=
DATABASE_URL_UNPOOLED=
RETRIQ_EMBEDDING_CACHE_ENABLED=true
# Standard text price for gemini-embedding-2, verified 2026-07-16.
# Recheck https://ai.google.dev/gemini-api/docs/pricing before later thesis runs.
RETRIQ_EMBEDDING_PRICE_USD_PER_MILLION_TOKENS=0.20
RETRIQ_EMBEDDING_CHARACTERS_PER_TOKEN=4
RETRIQ_TOP_K=4
RETRIQ_MIN_SCORE=0.18
RETRIQ_EVALUATION_LOG_ENABLED=true
RETRIQ_LLM_JUDGE_ENABLED=false
RETRIQ_LLM_JUDGE_MODEL=gemini-3.5-flash
RETRIQ_DOCLING_PYTHON=python
RETRIQ_DOCLING_TIMEOUT_MS=900000
# Set only for a faster smoke test; leave blank to process all pages.
RETRIQ_DOCLING_PAGE_RANGE=
