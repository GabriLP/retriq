GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
RETRIQ_EMBEDDING_CACHE_ENABLED=true
# Optional research estimate; set this from the provider price used for a specific experiment.
RETRIQ_EMBEDDING_PRICE_USD_PER_MILLION_TOKENS=
RETRIQ_EMBEDDING_CHARACTERS_PER_TOKEN=4
RETRIQ_TOP_K=4
RETRIQ_MIN_SCORE=0.18
RETRIQ_EVALUATION_LOG_ENABLED=true
RETRIQ_LLM_JUDGE_ENABLED=false
RETRIQ_LLM_JUDGE_MODEL=gemini-3.5-flash
RETRIQ_DOCLING_PYTHON=python
RETRIQ_DOCLING_TIMEOUT_MS=900000
# Set only for a faster smoke test; leave blank to process all pages.
RETRIQ_DOCLING_PAGE_RANGE=
